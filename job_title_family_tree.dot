// Software industry job title family tree, 1940s to the present.
// Dates (in each label, and the decade column) are roughly when a title became
// common, not its first recorded use. "c." = approximate.
// Solid edge: title grew directly out of the parent. Dashed edge: influence /
// people commonly moved across.
//
// Render: dot -Tsvg job_title_family_tree.dot -o job_title_family_tree.svg
//         dot -Tpng -Gdpi=110 job_title_family_tree.dot -o job_title_family_tree.png

digraph job_titles {
  graph [rankdir=LR, ranksep=0.9, nodesep=0.18, splines=true, newrank=true,
         fontname="Helvetica", fontsize=26, labelloc=t,
         label="Software industry job titles: a family tree (1940s to now)\n ",
         bgcolor=white];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11,
         penwidth=1.2, margin="0.12,0.05"];
  edge  [color="#777777", arrowsize=0.6, penwidth=1.0];

  // ---------------------------------------------------------------- timeline
  node [shape=plaintext, style="", fontsize=18, fontcolor="#444444"];
  t1940 [label="1940s"]; t1950 [label="1950s"]; t1960 [label="1960s"];
  t1970 [label="1970s"]; t1980 [label="1980s"]; t1990 [label="1990s"];
  t2000 [label="2000s"]; t2010 [label="2010s"]; t2020 [label="2020s"];
  t1940 -> t1950 -> t1960 -> t1970 -> t1980 -> t1990 -> t2000 -> t2010 -> t2020
    [color="#bbbbbb", penwidth=3, arrowsize=1.2];
  node [shape=box, style="rounded,filled", fontsize=11, fontcolor=black];

  // ---------------------------------------------------------------- families
  // Development
  node [fillcolor="#dbe9ff", color="#3b6fb6"];
  human_computer   [label="Computer\n(a person doing calculations)\n(from 17th C; common 1880s-1940s)"];
  coder            [label="Coder\n(c. 1945)"];
  programmer       [label="Programmer /\nComputer Programmer\n(c. 1950)", penwidth=2.5];
  sys_programmer   [label="Systems Programmer\n(c. 1962)"];
  app_programmer   [label="Application Programmer\n(c. 1965)"];
  analyst_prog     [label="Analyst/Programmer\n(c. 1970)"];
  software_eng     [label="Software Engineer\n(coined c. 1966; NATO conf. 1968)", penwidth=2.5];
  software_dev     [label="Software Developer\n(c. 1982)"];
  webmaster        [label="Webmaster\n(1993)"];
  web_dev          [label="Web Developer\n(c. 1995)"];
  frontend         [label="Front-end Developer\n(c. 2005)"];
  backend          [label="Back-end Developer\n(c. 2005)"];
  fullstack        [label="Full-stack Developer\n(c. 2008)"];
  mobile_dev       [label="Mobile / iOS / Android\nDeveloper\n(2008, App Store)"];
  game_dev         [label="Game Developer\n(c. 1982)"];
  embedded         [label="Embedded Software\nEngineer\n(c. 1978)"];
  senior_se        [label="Senior Software Engineer\n(c. 2000)"];
  staff_se         [label="Staff Software Engineer\n(c. 2012)"];
  principal_se     [label="Principal Engineer\n(c. 2010)"];
  distinguished    [label="Distinguished Engineer /\nFellow\n(IBM Fellow 1963; widespread c. 2010)"];
  dx_engineer      [label="Developer Experience\nEngineer\n(c. 2021)"];

  // Architecture and leadership
  node [fillcolor="#e8dcff", color="#6a4aa8"];
  dp_manager       [label="Data Processing (DP)\nManager\n(c. 1958)"];
  tech_lead        [label="Technical Lead /\nLead Programmer\n(c. 1972)"];
  it_manager       [label="IT Manager\n(c. 1985)"];
  cio              [label="CIO\n(c. 1981)"];
  cto              [label="CTO\n(common c. 1990)"];
  eng_manager      [label="Engineering Manager\n(c. 2005)"];
  vp_eng           [label="VP Engineering\n(c. 2000)"];
  software_arch    [label="Software Architect\n(c. 1992)"];
  solutions_arch   [label="Solutions Architect\n(c. 1998)"];
  enterprise_arch  [label="Enterprise Architect\n(c. 1995)"];
  cloud_arch       [label="Cloud Architect\n(c. 2011)"];
  project_manager  [label="Project Manager\n(software)\n(c. 1962)"];
  product_manager  [label="Product Manager\n(c. 1990)"];
  scrum_master     [label="Scrum Master /\nAgile Coach\n(c. 2002)"];
  platform_pm      [label="Platform Product\nManager\n(c. 2021)"];

  // Operations and infrastructure
  node [fillcolor="#dff3df", color="#3c8a3c"];
  computer_operator [label="Computer Operator\n(c. 1955)"];
  ops_analyst      [label="Operations Analyst\n(c. 1975)"];
  sysadmin         [label="Systems Administrator\n(Sysadmin)\n(c. 1980)", penwidth=2.5];
  unix_admin       [label="Unix / Linux\nAdministrator\n(c. 1990)"];
  windows_admin    [label="Windows / Exchange\nAdministrator\n(c. 1995)"];
  systems_eng      [label="Systems Engineer\n(c. 1985)"];
  config_manager   [label="Configuration Manager\n(c. 1975)"];
  build_release    [label="Build and Release\nEngineer\n(c. 2000)"];
  release_manager  [label="Release Manager\n(c. 1995)"];
  infra_eng        [label="Infrastructure Engineer\n(c. 2005)"];
  virtualisation   [label="Virtualisation Engineer\n(c. 2005)"];
  sre              [label="Site Reliability Engineer\n(SRE)\n(2003, Google)", penwidth=2.5];
  devops           [label="DevOps Engineer\n(coined 2009; title c. 2011)", penwidth=2.5];
  cloud_eng        [label="Cloud Engineer\n(c. 2010)"];
  cicd_eng         [label="CI/CD / Automation\nEngineer\n(c. 2012)"];
  platform_eng     [label="Platform Engineer\n(c. 2018)", penwidth=2.5];
  k8s_eng          [label="Kubernetes Engineer\n(c. 2017)"];
  chaos_eng        [label="Chaos Engineer\n(c. 2014, Netflix)"];
  observability    [label="Observability Engineer\n(c. 2020)"];
  finops           [label="FinOps Engineer /\nAnalyst\n(c. 2019)"];
  mlops            [label="MLOps Engineer\n(c. 2019)"];

  // Networks and security
  node [fillcolor="#ffe3cc", color="#c0661a"];
  comms_eng        [label="Communications /\nTelecoms Engineer\n(pre-1940s)"];
  network_admin    [label="Network Administrator\n(c. 1985)"];
  network_eng      [label="Network Engineer\n(c. 1990)", penwidth=2.5];
  network_arch     [label="Network Architect\n(c. 1995)"];
  cloud_network    [label="Cloud Network Engineer\n(c. 2015)"];
  sec_officer      [label="Information Security\nOfficer\n(c. 1978)"];
  sec_analyst      [label="Security Analyst\n(c. 1988)"];
  sec_engineer     [label="Security Engineer\n(c. 1995)"];
  pentester        [label="Penetration Tester /\nEthical Hacker\n(c. 2000)"];
  appsec           [label="Application Security\nEngineer\n(c. 2005)"];
  devsecops        [label="DevSecOps Engineer\n(c. 2015)"];
  ciso             [label="CISO\n(1995, Citicorp)"];
  ai_red_team      [label="AI Red Teamer\n(c. 2023)"];

  // Data and AI
  node [fillcolor="#fff6c2", color="#a88a00"];
  statistician     [label="Statistician\n(pre-1940s)"];
  data_librarian   [label="Data Librarian /\nTape Librarian\n(c. 1960)"];
  dba              [label="Database Administrator\n(DBA)\n(c. 1971)"];
  data_analyst     [label="Data Analyst\n(c. 1985)"];
  dw_developer     [label="Data Warehouse /\nBI Developer\n(c. 1988)"];
  etl_dev          [label="ETL Developer\n(c. 1995)"];
  big_data         [label="Big Data / Hadoop\nEngineer\n(c. 2009)"];
  data_scientist   [label="Data Scientist\n(2008)", penwidth=2.5];
  data_engineer    [label="Data Engineer\n(c. 2013)"];
  analytics_eng    [label="Analytics Engineer\n(c. 2019)"];
  ml_engineer      [label="Machine Learning\nEngineer\n(c. 2015)"];
  prompt_eng       [label="Prompt Engineer\n(c. 2022)"];
  ai_engineer      [label="AI Engineer\n(c. 2023)", penwidth=2.5];
  agent_eng        [label="AI Agent /\nContext Engineer\n(c. 2025)"];

  // Quality and test
  node [fillcolor="#ffdbe4", color="#b03a5b"];
  tester           [label="Software Tester\n(c. 1975)"];
  qa_engineer      [label="QA Engineer\n(c. 1985)"];
  sdet             [label="SDET (Software Dev\nEngineer in Test)\n(c. 2005, Microsoft)"];
  test_automation  [label="Test Automation\nEngineer\n(c. 2010)"];

  // Support and customer-facing
  node [fillcolor="#e6e6e6", color="#666666"];
  customer_eng     [label="Customer Engineer /\nField Engineer (IBM CE)\n(IBM, from 1930s)"];
  presales_se      [label="Systems Engineer\n(pre-sales, IBM SE)\n(c. 1962)"];
  tech_support     [label="Technical Support\n(c. 1970)"];
  helpdesk         [label="Help Desk Technician\n(c. 1982)"];
  service_desk     [label="Service Desk Analyst\n(c. 1999, ITIL)"];
  app_support      [label="Application Support\nAnalyst\n(c. 1995)"];
  support_eng      [label="Support Engineer\n(c. 2005)"];
  sales_eng        [label="Sales Engineer\n(c. 1990)"];
  solutions_eng    [label="Solutions Engineer\n(c. 2012)"];
  consultant       [label="IT Consultant\n(c. 1980)"];
  evangelist       [label="Technology Evangelist\n(1984, Apple)"];
  dev_advocate     [label="Developer Advocate /\nDevRel\n(c. 2008)"];
  fde              [label="Forward Deployed\nEngineer\n(c. 2010, Palantir; boom 2025)", penwidth=2.5];
  tech_writer      [label="Technical Writer\n(c. 1960)"];
  systems_analyst  [label="Systems Analyst\n(c. 1955)"];
  business_analyst [label="Business Analyst\n(c. 1990)"];

  // ---------------------------------------------------------------- eras
  {rank=same; t1940; human_computer; coder; comms_eng; statistician; customer_eng; }
  {rank=same; t1950; programmer; computer_operator; systems_analyst;
                     dp_manager; data_librarian; }
  {rank=same; t1960; sys_programmer; app_programmer; software_eng; presales_se;
                     tech_writer; project_manager; }
  {rank=same; t1970; analyst_prog; dba; tech_support; tester; ops_analyst;
                     tech_lead; config_manager; embedded; sec_officer; }
  {rank=same; t1980; software_dev; sysadmin; network_admin; helpdesk; qa_engineer;
                     it_manager; cio; consultant; evangelist; game_dev; sec_analyst;
                     systems_eng; data_analyst; dw_developer; }
  {rank=same; t1990; webmaster; web_dev; software_arch; solutions_arch;
                     enterprise_arch; unix_admin; windows_admin; network_eng;
                     network_arch; sec_engineer; business_analyst; cto;
                     release_manager; etl_dev; product_manager; sales_eng;
                     app_support; service_desk; ciso; }
  {rank=same; t2000; frontend; backend; fullstack; senior_se; sre; build_release;
                     virtualisation; infra_eng; pentester; appsec; sdet;
                     scrum_master; eng_manager; vp_eng; data_scientist;
                     big_data; dev_advocate; support_eng; mobile_dev; }
  {rank=same; t2010; staff_se; principal_se; distinguished; devops; cloud_eng;
                     cloud_arch; cicd_eng; platform_eng; k8s_eng; chaos_eng;
                     devsecops; cloud_network; data_engineer; ml_engineer;
                     test_automation; solutions_eng; fde; }
  {rank=same; t2020; observability; finops; mlops; analytics_eng; prompt_eng;
                     ai_engineer; agent_eng; platform_pm; dx_engineer; ai_red_team; }

  // ---------------------------------------------------------------- lineage
  // Development
  human_computer -> programmer;
  coder -> programmer;
  programmer -> sys_programmer;
  programmer -> app_programmer;
  programmer -> software_eng;
  programmer -> analyst_prog;
  systems_analyst -> analyst_prog;
  app_programmer -> software_dev;
  analyst_prog -> software_dev;
  software_eng -> software_dev [dir=both, style=dashed];
  software_eng -> embedded;
  software_eng -> senior_se;
  senior_se -> staff_se;
  staff_se -> principal_se;
  principal_se -> distinguished;
  software_dev -> game_dev;
  software_dev -> web_dev;
  webmaster -> web_dev;
  web_dev -> frontend;
  web_dev -> backend;
  frontend -> fullstack;
  backend -> fullstack;
  software_dev -> mobile_dev;
  platform_eng -> dx_engineer;
  dev_advocate -> dx_engineer [style=dashed];

  // Architecture and leadership
  programmer -> tech_lead;
  tech_lead -> eng_manager;
  eng_manager -> vp_eng;
  vp_eng -> cto [style=dashed, constraint=false];
  dp_manager -> it_manager;
  it_manager -> cio;
  cio -> cto [style=dashed];
  software_eng -> software_arch;
  software_arch -> solutions_arch;
  systems_analyst -> solutions_arch [style=dashed];
  solutions_arch -> enterprise_arch;
  solutions_arch -> cloud_arch;
  project_manager -> scrum_master;
  project_manager -> product_manager [style=dashed];
  product_manager -> platform_pm;
  platform_eng -> platform_pm [style=dashed];
  systems_analyst -> business_analyst;

  // Operations and infrastructure
  computer_operator -> ops_analyst;
  computer_operator -> sysadmin;
  sys_programmer -> sysadmin;
  sysadmin -> unix_admin;
  sysadmin -> windows_admin;
  sysadmin -> systems_eng;
  systems_eng -> infra_eng;
  sysadmin -> virtualisation;
  virtualisation -> cloud_eng;
  infra_eng -> cloud_eng;
  config_manager -> build_release;
  release_manager -> build_release;
  config_manager -> release_manager;
  build_release -> devops;
  build_release -> cicd_eng;
  unix_admin -> devops;
  unix_admin -> sre;
  software_eng -> sre;
  ops_analyst -> sre [style=dashed];
  sre -> devops [dir=both, style=dashed];
  sre -> chaos_eng;
  sre -> observability;
  devops -> platform_eng;
  sre -> platform_eng;
  cloud_eng -> platform_eng [constraint=false];
  cloud_eng -> k8s_eng [constraint=false];
  k8s_eng -> platform_eng [constraint=false];
  cloud_eng -> finops;
  devops -> mlops;
  ml_engineer -> mlops;

  // Networks and security
  comms_eng -> network_admin;
  sysadmin -> network_admin [constraint=false];
  network_admin -> network_eng;
  network_eng -> network_arch [constraint=false];
  network_eng -> cloud_network;
  cloud_eng -> cloud_network [style=dashed, constraint=false];
  sec_officer -> sec_analyst;
  sec_officer -> ciso;
  sec_analyst -> sec_engineer;
  network_eng -> sec_engineer [style=dashed, constraint=false];
  sec_engineer -> pentester;
  sec_engineer -> appsec;
  appsec -> devsecops;
  devops -> devsecops [constraint=false];
  pentester -> ai_red_team;

  // Data and AI
  data_librarian -> dba;
  sys_programmer -> dba;
  statistician -> data_analyst;
  dba -> dw_developer;
  dw_developer -> etl_dev;
  etl_dev -> big_data;
  big_data -> data_engineer;
  etl_dev -> data_engineer;
  data_engineer -> analytics_eng;
  data_analyst -> analytics_eng;
  data_analyst -> data_scientist;
  statistician -> data_scientist;
  data_scientist -> ml_engineer;
  software_eng -> ml_engineer [style=dashed];
  data_scientist -> prompt_eng [style=dashed];
  ml_engineer -> ai_engineer;
  software_eng -> ai_engineer;
  prompt_eng -> ai_engineer [constraint=false];
  ai_engineer -> agent_eng [constraint=false];

  // Quality and test
  programmer -> tester [style=dashed];
  tester -> qa_engineer;
  qa_engineer -> sdet;
  sdet -> test_automation;
  test_automation -> cicd_eng [style=dashed, constraint=false];

  // Support and customer-facing
  customer_eng -> tech_support;
  customer_eng -> presales_se;
  tech_support -> helpdesk;
  helpdesk -> service_desk;
  tech_support -> app_support;
  app_support -> support_eng;
  app_support -> sre [style=dashed];
  presales_se -> sales_eng;
  presales_se -> consultant;
  sales_eng -> solutions_eng;
  solutions_eng -> fde [constraint=false];
  software_eng -> fde;
  consultant -> fde [style=dashed];
  evangelist -> dev_advocate;
  programmer -> tech_writer [style=dashed];

  // ---------------------------------------------------------------- legend
  subgraph cluster_legend {
    label="Key"; fontsize=14; style=rounded; color="#999999";
    node [fontsize=10, width=1.9];
    l_dev  [label="Development",                 fillcolor="#dbe9ff", color="#3b6fb6"];
    l_lead [label="Architecture / leadership",   fillcolor="#e8dcff", color="#6a4aa8"];
    l_ops  [label="Operations / infrastructure", fillcolor="#dff3df", color="#3c8a3c"];
    l_net  [label="Networks / security",         fillcolor="#ffe3cc", color="#c0661a"];
    l_data [label="Data / AI",                   fillcolor="#fff6c2", color="#a88a00"];
    l_qa   [label="Quality / test",              fillcolor="#ffdbe4", color="#b03a5b"];
    l_sup  [label="Support / customer-facing",   fillcolor="#e6e6e6", color="#666666"];
    l_note [shape=plaintext, style="", fontsize=10, label=<
      <b>Solid arrow</b>: title grew out of the parent<br/>
      <b>Dashed arrow</b>: influence / common career move<br/>
      <b>Thick border</b>: landmark title<br/>
      Dates and columns: roughly when a title became<br/>common, not its first recorded use.<br/>
      c. = approximate>];
  }
  {rank=same; t1940; l_dev; l_lead; l_ops; l_net; l_data; l_qa; l_sup; l_note; }
}
